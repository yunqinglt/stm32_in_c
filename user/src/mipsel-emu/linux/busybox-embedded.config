# BusyBox feature fragment for the headless MIPS guest.  The initramfs script
# starts from allnoconfig, applies this fragment, then runs oldconfig.
CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_CTTYHACK=y
CONFIG_MOUNT=y
CONFIG_MKDIR=y
CONFIG_SETSID=y
CONFIG_SLEEP=y
CONFIG_ECHO=y
CONFIG_LS=y
CONFIG_DMESG=y
CONFIG_GREP=y
CONFIG_PWD=y
CONFIG_PS=y
CONFIG_STTY=y
CONFIG_SYNC=y
CONFIG_UMOUNT=y
CONFIG_UNAME=y
CONFIG_CAT=y
CONFIG_HEXDUMP=y
CONFIG_FREE=y
CONFIG_TOP=y
