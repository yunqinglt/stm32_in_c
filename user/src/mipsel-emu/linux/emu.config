# Emulator console/debug fragment for a MIPS generic UHI kernel.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y

# Keep printk on the UART before the normal 8250 driver probes.
CONFIG_SERIAL_EARLYCON=y

# The emulator implements a MIPS32 Release 2 little-endian CPU.  Keep these
# architecture choices in the reusable fragment so tinyconfig cannot fall
# back to its generic big-endian/MIPS32r1 defaults.
CONFIG_CPU_MIPS32_R2=y
CONFIG_CPU_LITTLE_ENDIAN=y
CONFIG_MIPS_O32_FP64_SUPPORT=y

CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_OF_PLATFORM=y

# The CH32 profile has no guest graphics device. Keep these explicit negative
# entries so rerunning merge_config cannot retain a previous desktop build.
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_FB_SIMPLE is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_FONT_SUPPORT is not set
# CONFIG_FONT_8x16 is not set

CONFIG_OF=y
CONFIG_OF_EARLY_FLATTREE=y
CONFIG_UHI_BOOT=y
CONFIG_MIPS_CMDLINE_FROM_DTB=y
# CONFIG_MIPS_CMDLINE_FROM_BOOTLOADER is not set

# The bundled musl toolchain uses the hard-float O32 ABI.  The emulated CPU
# intentionally has no CP1, so let Linux emulate user-space FP instructions
# raised as Coprocessor Unusable exceptions.
CONFIG_MIPS_FP_SUPPORT=y

# External newc initramfs supplied by the emulator loader.  Keep only gzip as
# the optional decompressor; an uncompressed newc archive works as well.
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set

# Minimal statically linked BusyBox userspace and its usual pseudo filesystems.
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
