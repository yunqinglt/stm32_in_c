# Minimal initramfs for mipsel-emu.  The two file locations are supplied by
# build-initramfs.sh through the environment.
dir /bin 0755 0 0
dir /sbin 0755 0 0
dir /usr 0755 0 0
dir /usr/bin 0755 0 0
dir /usr/sbin 0755 0 0
dir /dev 0755 0 0
dir /dev/pts 0755 0 0
dir /dev/shm 1777 0 0
dir /proc 0555 0 0
dir /sys 0555 0 0
dir /run 0755 0 0
dir /tmp 1777 0 0
dir /root 0700 0 0
dir /etc 0755 0 0

nod /dev/console 0600 0 0 c 5 1
nod /dev/null 0666 0 0 c 1 3

file /init ${MIPSEL_EMU_INIT} 0755 0 0
file /bin/busybox ${MIPSEL_EMU_BUSYBOX} 0755 0 0

slink /bin/ash busybox 0777 0 0
slink /bin/cat busybox 0777 0 0
slink /bin/cp busybox 0777 0 0
slink /bin/cttyhack busybox 0777 0 0
slink /bin/date busybox 0777 0 0
slink /bin/dd busybox 0777 0 0
slink /bin/dmesg busybox 0777 0 0
slink /bin/echo busybox 0777 0 0
slink /bin/grep busybox 0777 0 0
slink /bin/kill busybox 0777 0 0
slink /bin/ln busybox 0777 0 0
slink /bin/ls busybox 0777 0 0
slink /bin/mkdir busybox 0777 0 0
slink /bin/mknod busybox 0777 0 0
slink /bin/mount busybox 0777 0 0
slink /bin/mountpoint busybox 0777 0 0
slink /bin/ps busybox 0777 0 0
slink /bin/pwd busybox 0777 0 0
slink /bin/rm busybox 0777 0 0
slink /bin/sh busybox 0777 0 0
slink /bin/sleep busybox 0777 0 0
slink /bin/stty busybox 0777 0 0
slink /bin/sync busybox 0777 0 0
slink /bin/touch busybox 0777 0 0
slink /bin/umount busybox 0777 0 0
slink /bin/uname busybox 0777 0 0
slink /bin/vi busybox 0777 0 0

slink /sbin/halt ../bin/busybox 0777 0 0
slink /sbin/mdev ../bin/busybox 0777 0 0
slink /sbin/poweroff ../bin/busybox 0777 0 0
slink /sbin/reboot ../bin/busybox 0777 0 0
slink /usr/bin/clear ../../bin/busybox 0777 0 0
slink /usr/bin/free ../../bin/busybox 0777 0 0
slink /usr/bin/hexdump ../../bin/busybox 0777 0 0
slink /usr/bin/setsid ../../bin/busybox 0777 0 0
slink /usr/bin/top ../../bin/busybox 0777 0 0
slink /usr/bin/tty ../../bin/busybox 0777 0 0
slink /linuxrc bin/busybox 0777 0 0
